<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ExampleMod</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Hollow Knight Silksong/Hollow Knight Silksong.app/Contents/Resources/Data/Managed</ManagedDir>
    <NoWarn>$(NoWarn);CS0626;CS0108;CS0109;CS0114;CS0649;CS0169;CS0414;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/*.dll"
               Exclude="$(ManagedDir)/System*.dll;$(ManagedDir)/mscorlib.dll;$(ManagedDir)/netstandard.dll;$(ManagedDir)/Microsoft*.dll;$(ManagedDir)/Mono*.dll;$(ManagedDir)/MMHOOK_*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
